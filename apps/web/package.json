{
    "name": "peanut-split",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.17.1",
    "scripts": {
        "dev": "next dev",
        "build": "next build --webpack && node scripts/assert-pwa-build-boundary.mjs",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "pnpm format:check && pnpm classes:audit",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "test": "vitest run",
        "currencies:gen": "node scripts/gen-currency-catalog.mjs",
        "i18n:audit": "node scripts/i18n-audit.mjs",
        "marketing-copy:audit": "node scripts/marketing-copy-audit.mjs",
        "marketing-copy:audit:all": "node scripts/marketing-copy-audit.mjs --include-generated",
        "ui-icons:audit": "node scripts/ui-icon-audit.mjs",
        "classes:audit": "node scripts/tailwind-class-audit.mjs",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "e2e:pwa-boundary": "playwright test --config playwright.pwa-boundary.config.ts",
        "e2e:v2": "playwright test --config playwright.v2.config.ts",
        "icons": "node scripts/generate-icons.mjs"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "prisma",
            "esbuild",
            "sharp",
            "@swc/core",
            "@sentry/cli"
        ],
        "overrides": {
            "effect@<3.20.0": "^3.22.2",
            "deepmerge-ts@<8.0.0": "^8.0.2",
            "browserslist@<4.28.7": "^4.29.2"
        }
    },
    "dependencies": {
        "@fontsource/gluten": "4.5.12",
        "@fontsource/roboto": "4.5.8",
        "@headlessui/tailwindcss": "^0.2.2",
        "@number-flow/react": "^0.5.14",
        "@prisma/client": "^6.19.3",
        "@sentry/nextjs": "^10.75.3",
        "@serwist/next": "^9.5.12",
        "@tanstack/react-query": "^5.104.0",
        "fastest-levenshtein": "1.0.16",
        "gray-matter": "^4.0.3",
        "https-proxy-agent": "^9.1.0",
        "motion": "^12.43.0",
        "next": "16.3.7",
        "next-intl": "^4.14.8",
        "next-mdx-remote": "^6.0.0",
        "nuqs": "^2.10.1",
        "posthog-js": "^1.434.18",
        "prisma": "^6.19.3",
        "qrcode.react": "4.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.35.5",
        "sonner": "^2.0.8",
        "tailwind-merge": "^1.14.0",
        "undici": "^8.11.2",
        "vaul": "^1.1.2",
        "web-push": "^3.6.7",
        "zod": "3.24.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/web-push": "^3.6.4",
        "autoprefixer": "^10.6.1",
        "postcss": "^8.5.28",
        "postcss-import": "^16.2.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "serwist": "^9.5.12",
        "tailwind-scrollbar": "^3.1.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
