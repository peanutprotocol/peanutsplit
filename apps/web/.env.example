# Postgres. `docker compose up db` serves exactly this URL; any local Postgres works.
DATABASE_URL=postgresql://split:split@localhost:5433/split

# Handler tests run against a throwaway database — create it once with
# `createdb peanut_split_test`; vitest applies the migrations on every run.
TEST_DATABASE_URL=postgresql://peanut:peanut@localhost:5432/peanut_split_test

# Set to `static` to pin FX to the built-in indicative table and never call out.
SPLIT_FX_MODE=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Analytics + errors are no-ops when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# — Accounts (optional email login, purely for reopening your rooms on a new
#   device). Unset means unset: no magic links, no sessions, no behaviour change.

# Signs magic-link tokens and seals the session cookie. Any long random string;
# rotating it invalidates every live link and signs everyone out. Required in
# production — without it the auth routes answer 503.
SPLIT_AUTH_SECRET=

# Resend. Both must be set or nothing is sent; in development the magic link is
# printed to the server console instead.
RESEND_API_KEY=
SPLIT_EMAIL_FROM=

# The production container has no egress — point this at the pinned egress proxy
# so the Resend call has a way out. Empty locally.
SPLIT_EMAIL_PROXY_URL=

# Gates the accounts UI (later phase). The backend is already inert without
# SPLIT_AUTH_SECRET; this is what keeps the screens hidden.
NEXT_PUBLIC_ACCOUNTS_ENABLED=
