# Postgres. `docker compose up db` serves exactly this URL; any local Postgres works.
DATABASE_URL=postgresql://split:split@localhost:5433/split

# Handler tests run against a throwaway database — create it once with
# `createdb peanut_split_test`; vitest applies the migrations on every run.
TEST_DATABASE_URL=postgresql://peanut:peanut@localhost:5432/peanut_split_test

# Set to `static` to pin FX to the built-in indicative table and never call out.
SPLIT_FX_MODE=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Web push. Unset → the whole pipeline is inert (one warn on first use, no sends).
# Generate a pair once with `npx web-push generate-vapid-keys`.
# NEVER rotate these in place: every stored subscription is bound to the public
# key it was created against, so a swap silently kills every existing device.
SPLIT_VAPID_PUBLIC_KEY=
SPLIT_VAPID_PRIVATE_KEY=
# Contact address the push services reach if a sender misbehaves. Must be mailto:.
SPLIT_VAPID_SUBJECT=mailto:hello@peanut.me
# Same public key, inlined into the client that will ask for permission (build arg).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The prod container has no egress — an HTTPS proxy pinned at the push services.
# Unset means a direct request, which is what you want locally.
SPLIT_PUSH_PROXY_URL=

# Analytics + errors are no-ops when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
