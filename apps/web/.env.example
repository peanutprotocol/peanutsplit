# Postgres. `docker compose up db` serves exactly this URL; any local Postgres works.
DATABASE_URL=postgresql://split:split@localhost:5433/split

# Handler tests run against a throwaway database on the supplied Compose instance; Vitest applies
# migrations on every run. Create it once as documented in `docs/current/TESTING.md`.
TEST_DATABASE_URL=postgresql://split:split@localhost:5433/peanut_split_test

# Playwright uses a second disposable database. Playwright does not load this value from `.env`
# itself, so export/pass it when invoking the suite as documented in the testing guide.
E2E_DATABASE_URL=postgresql://split:split@localhost:5433/peanut_split_dev

# Fork-safe default: pin FX to the built-in indicative table and never call out.
# To use a live feed, change the mode and provide the endpoint explicitly.
SPLIT_FX_MODE=static
SPLIT_FX_ENDPOINT=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Generated Split guides. Every public URL is derived from peanutsplit.com in source, so there is
# no origin to configure here.
#
# Says whether THIS deployment is the one allowed to advertise the released guides. The standalone
# image gets `true` from the official-host Dockerfile; Compose passes this explicit false value, so
# a fork or dev box never claims to be the indexed site. Runtime can only preserve or disable the
# source-controlled release registry — it can never release a path the registry does not name.
SEO_INDEXABLE=false

# Product boundary. Unset keeps the deliberately small v1 surface; set to `1`
# only for a v2 build that should expose AI assistance and migration tools.
NEXT_PUBLIC_SPLIT_V2_ENABLED=

# Build-time legal/marketing boundary. Leave unset in private or incomplete snapshots. Set to the
# literal `1` only once this repository is public with its AGPL license, notices, security review
# and self-hosting documentation in place. This exposes /source and the FOSS comparison copy;
# changing it on a running container has no effect.
NEXT_PUBLIC_FOSS_RELEASED=
# The 40-hex commit this image was built from. /source links the public tree at exactly this commit,
# which is how the running service offers its corresponding source. Without it the gate stays shut.
NEXT_PUBLIC_BUILD_COMMIT=

# Runtime-only emergency switch for the bulk import endpoint. Missing/true
# keeps imports available; set to `false`, `off`, or `0` to return 503 before
# reading a body or opening a transaction.
SPLIT_IMPORT_ENABLED=

# Landing rollback. Unset (or `pass_link`) serves the Pass-the-Link fold.
# Set to the exact value `control` at build time to restore the compact hero.
# Like every NEXT_PUBLIC_* value, changing this at runtime does nothing.
NEXT_PUBLIC_LANDING_VARIANT=

# Web push. Unset → the whole pipeline is inert (one warn on first use, no sends).
# Generate a pair once with `npx web-push generate-vapid-keys`.
# NEVER rotate these in place: every stored subscription is bound to the public
# key it was created against, so a swap silently kills every existing device.
SPLIT_VAPID_PUBLIC_KEY=
SPLIT_VAPID_PRIVATE_KEY=
# Contact address the push services reach if a sender misbehaves. Must be mailto:.
SPLIT_VAPID_SUBJECT=mailto:hello@peanut.me
# Same public key, inlined into the client that will ask for permission (build arg).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The prod container has no egress — an HTTPS proxy pinned at the push services.
# Unset means a direct request, which is what you want locally.
SPLIT_PUSH_PROXY_URL=

# Analytics + errors are no-ops when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Browser-side only — the container has no egress, so server events could never leave.
NEXT_PUBLIC_SENTRY_DSN=

# — V2 model feature: bill scanning (photo → line items → EXACT split).
#
# `NEXT_PUBLIC_SPLIT_V2_ENABLED=1` is the product gate. Inside a v2 build, the UI
# asks `GET /api/rooms/:slug/receipt-parse` because only the server knows whether
# a model key exists. V1 never makes that probe and all model routes return 404.
# In v2, an unset key makes the receipt model route answer 503.
#
# Two transports: OpenRouter wins when both are set, and nothing else changes
# with the wire: same prompts, same parsing, same refusal to trust the model's
# arithmetic.
# The image is forwarded once. Split's server does not persist the image or
# extracted content and does not include either in Split logs. An image shared
# into the installed Android PWA is temporarily parked in that device's Cache
# Storage for the room handoff; it is one-shot and rejected after ten minutes.
# Provider handling still follows the configured provider's terms: OpenRouter
# requests require denied data collection and ZDR; direct Gemini requires an
# explicit paid-tier confirmation.

# Preferred. Company OpenRouter account — mint a Split-only key with a per-key
# spend cap set on it, so a runaway loop in a semi-trusted container costs a
# capped amount rather than the account balance.
SPLIT_OPENROUTER_API_KEY=
# Optional override, OpenRouter's model ids (`vendor/model`). Defaults to the
# cheapest vision-capable model that reads printed text well.
SPLIT_SCAN_MODEL=

# Fallback. Google AI Studio key, talking to Gemini's own REST API.
SPLIT_GEMINI_API_KEY=
# Required for the direct fallback. A bare/unpaid key stays disabled because
# unpaid Gemini may use submitted receipt images to improve Google products.
SPLIT_GEMINI_PAID_TIER_CONFIRMED=
# Optional override for that path only — Google's bare model ids, no vendor
# prefix. Ignored when the OpenRouter key is set.
SPLIT_GEMINI_MODEL=

# The production container has no egress — point this at the pinned proxy, and
# add whichever host the configured transport uses (`openrouter.ai` or
# `generativelanguage.googleapis.com`) to the squid allowlist alongside the push
# gateways. Empty locally. Carries receipt-scanning traffic.
SPLIT_SCAN_PROXY_URL=
