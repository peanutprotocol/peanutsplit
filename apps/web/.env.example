# Postgres. `docker compose up db` serves exactly this URL; any local Postgres works.
DATABASE_URL=postgresql://split:split@localhost:5433/split

# Handler tests run against a throwaway database — create it once with
# `createdb peanut_split_test`; vitest applies the migrations on every run.
TEST_DATABASE_URL=postgresql://peanut:peanut@localhost:5432/peanut_split_test

# Set to `static` to pin FX to the built-in indicative table and never call out.
SPLIT_FX_MODE=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Product boundary. Unset keeps the deliberately small v1 surface; set to `1`
# only for a v2 build that should expose AI assistance and migration tools.
NEXT_PUBLIC_SPLIT_V2_ENABLED=

# Landing rollback. Unset (or `pass_link`) serves the Pass-the-Link fold.
# Set to the exact value `control` at build time to restore the compact hero.
# Like every NEXT_PUBLIC_* value, changing this at runtime does nothing.
NEXT_PUBLIC_LANDING_VARIANT=

# Web push. Unset → the whole pipeline is inert (one warn on first use, no sends).
# Generate a pair once with `npx web-push generate-vapid-keys`.
# NEVER rotate these in place: every stored subscription is bound to the public
# key it was created against, so a swap silently kills every existing device.
SPLIT_VAPID_PUBLIC_KEY=
SPLIT_VAPID_PRIVATE_KEY=
# Contact address the push services reach if a sender misbehaves. Must be mailto:.
SPLIT_VAPID_SUBJECT=mailto:hello@peanut.me
# Same public key, inlined into the client that will ask for permission (build arg).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The prod container has no egress — an HTTPS proxy pinned at the push services.
# Unset means a direct request, which is what you want locally.
SPLIT_PUSH_PROXY_URL=

# Analytics + errors are no-ops when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Browser-side only — the container has no egress, so server events could never leave.
NEXT_PUBLIC_SENTRY_DSN=

# — Accounts (optional email login, purely for reopening your rooms on a new
#   device). Unset means unset: no magic links, no sessions, no behaviour change.

# Signs magic-link tokens and seals the session cookie. Any long random string;
# rotating it invalidates every live link and signs everyone out. Required in
# production — without it the auth routes answer 503.
SPLIT_AUTH_SECRET=

# Email transport — OneSignal wins when both are set; SPLIT_EMAIL_FROM is
# required either way. Nothing configured → nothing is sent, and in development
# the magic link is printed to the server console instead.
# The OneSignal pair MUST be a separate Split-only OneSignal app, never
# Peanut's — this container is semi-trusted and Peanut's key reaches Peanut's
# whole audience.
SPLIT_ONESIGNAL_APP_ID=
SPLIT_ONESIGNAL_API_KEY=
RESEND_API_KEY=
SPLIT_EMAIL_FROM=

# The production container has no egress — point this at the pinned egress proxy
# so the email call has a way out. Empty locally.
SPLIT_EMAIL_PROXY_URL=

# Teaser state: announces the save-your-rooms row with a Soon badge while the
# email transport clears its external gates. ENABLED wins over SOON.
NEXT_PUBLIC_ACCOUNTS_SOON=

# Gates the accounts UI (later phase). The backend is already inert without
# SPLIT_AUTH_SECRET; this is what keeps the screens hidden.
NEXT_PUBLIC_ACCOUNTS_ENABLED=

# — V2 model features. ONE key, BOTH typing-removers:
#     bill scanning  (photo → line items → EXACT split)
#     quick add      (a typed or pasted line → a prefilled expense form)
#
# `NEXT_PUBLIC_SPLIT_V2_ENABLED=1` is the product gate. Inside a v2 build, the UI
# asks `GET /api/rooms/:slug/receipt-parse` because only the server knows whether
# a model key exists. V1 never makes that probe and all model routes return 404.
# In v2, an unset key makes both model routes answer 503.
#
# Two transports, exactly like the email pair above — OpenRouter wins when both
# are set, and nothing else changes with the wire: same prompts, same parsing,
# same refusal to trust the model's arithmetic.
# The image and the typed text are forwarded once and never stored, anywhere, on
# either path — and neither ever reaches a log.

# Preferred. Company OpenRouter account — mint a Split-only key with a per-key
# spend cap set on it, so a runaway loop in a semi-trusted container costs a
# capped amount rather than the account balance.
SPLIT_OPENROUTER_API_KEY=
# Optional override, OpenRouter's model ids (`vendor/model`). Defaults to the
# cheapest vision-capable model that reads printed text well. Named SCAN because
# scanning shipped first; it selects the model for quick add too.
SPLIT_SCAN_MODEL=

# Fallback. Google AI Studio key, talking to Gemini's own REST API.
SPLIT_GEMINI_API_KEY=
# Optional override for that path only — Google's bare model ids, no vendor
# prefix. Ignored when the OpenRouter key is set.
SPLIT_GEMINI_MODEL=

# The production container has no egress — point this at the pinned proxy, and
# add whichever host the configured transport uses (`openrouter.ai` or
# `generativelanguage.googleapis.com`) to the squid allowlist alongside the push
# gateways and the email API. Empty locally. Carries both features' traffic.
SPLIT_SCAN_PROXY_URL=
