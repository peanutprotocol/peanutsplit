{
  "name": "@peanut-split/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "simulate:webhook": "tsx scripts/simulate-peanut-webhook.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/type-provider-typebox": "^4.0.0",
    "@prisma/client": "6.18.0",
    "@sentry/node": "^8.55.0",
    "@sinclair/typebox": "^0.32.34",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "prisma": "6.18.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
