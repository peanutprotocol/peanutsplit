{
  "name": "@peanut-split/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:integration": "REQUIRE_DB=1 jest --runInBand src/db/split.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "simulate:webhook": "tsx scripts/simulate-peanut-webhook.ts",
    "verify:settle": "bash scripts/verify-settle-loop.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@prisma/client": "6.18.0",
    "@sentry/node": "^10.75.3",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "prisma": "6.18.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
