DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peanut_split?schema=app"
PORT=5051
CORS_ORIGINS=http://localhost:3051
SENTRY_DSN=

# Shared secret for verifying Peanut's payment-completed callback. The webhook
# fails closed without it (503) — an unsigned callback endpoint is a
# ledger-write primitive for anyone who finds the URL.
PEANUT_WEBHOOK_SECRET=

# Where the payer is sent to pay. Placeholders: {amount} (major units),
# {currency}, {reference}, {note}. The default is a PLACEHOLDER shape — see
# src/peanut/index.ts for what is real and what is assumed.
PEANUT_PAY_URL_TEMPLATE=
